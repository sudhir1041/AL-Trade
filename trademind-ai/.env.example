# =============================================================================
# TradeMind AI – Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# ─────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=True

# ─────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────
DB_NAME=trademind_db
DB_USER=trademind_user
DB_PASSWORD=trademind_password
DB_HOST=postgres
DB_PORT=5432

# Connection pool settings
DB_CONN_MAX_AGE=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://:redis_password@redis:6379/0
REDIS_PASSWORD=redis_password
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_RATE_LIMIT_DB=3

# ─────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672

# ─────────────────────────────────────────
# Celery
# ─────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://:redis_password@redis:6379/4
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# ─────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SLIDING_TOKEN_LIFETIME_MINUTES=30
JWT_ALGORITHM=HS256

# ─────────────────────────────────────────
# Encryption (API key storage at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ─────────────────────────────────────────
ENCRYPTION_KEY=generate-with-fernet-key-generate

# ─────────────────────────────────────────
# Email
# ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=TradeMind AI <noreply@trademind.ai>
EMAIL_TIMEOUT=30

# ─────────────────────────────────────────
# Telegram Notifications
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_PARSE_MODE=HTML

# ─────────────────────────────────────────
# Stripe Billing
# ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2024-06-20

# ─────────────────────────────────────────
# Exchange API Keys (defaults – users provide their own)
# ─────────────────────────────────────────
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=True

# Zerodha / Kite
KITE_API_KEY=
KITE_API_SECRET=

# Angel One
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ─────────────────────────────────────────
# Frontend / CORS
# ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────
RATE_LIMIT_ANON=100/hour
RATE_LIMIT_AUTH=1000/hour
RATE_LIMIT_TRADING=100/minute

# ─────────────────────────────────────────
# Monitoring & Observability
# ─────────────────────────────────────────
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=admin_password
GF_SECURITY_ADMIN_USER=admin

# ─────────────────────────────────────────
# ML / AI Engine
# ─────────────────────────────────────────
ML_MODELS_PATH=/app/ml_models
ML_RETRAINING_SCHEDULE=weekly
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────
# Storage (S3-compatible for reports/exports)
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=trademind-media
AWS_S3_REGION_NAME=ap-south-1
USE_S3=False
